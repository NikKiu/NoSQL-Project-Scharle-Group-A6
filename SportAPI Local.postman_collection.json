        {
          "name": "POST /auth/login (Admin -> Set authToken)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "const token = (response && response.auth && response.auth.token) || response.access_token || response.token;",
                  "",
                  "pm.test('Auth token vorhanden', function () {",
                  "  pm.expect(token).to.be.a('string').and.not.empty;",
                  "});",
                  "",
                  "if (token) {",
                  "  pm.collectionVariables.set('authToken', token);",
                  "  console.log('Collection authToken gesetzt:', token);",
                  "}",
                  "",
                  "if (response && response.user && response.user.athleteId) {",
                  "  pm.collectionVariables.set('athleteId', response.user.athleteId);",
                  "}",
                  ""
                ],
                "type": "text/javascript"
              }
            }
          ],
