{
  "info": {
    "name": "SportAPI Local",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3000/api" },
    { "key": "adminUserId", "value": "admin-1" },
    { "key": "adminRole", "value": "admin" },
    { "key": "athleteUserId", "value": "athlete-user-1" },
    { "key": "athleteRole", "value": "athlete" },
    { "key": "athleteId", "value": "athlete-1" },
    { "key": "sessionId", "value": "session-1" }
  ],
  "item": [
    {
      "name": "1 - Health",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/health"
      }
    },
    {
      "name": "2 - List Athletes (Admin)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "url": "{{baseUrl}}/athletes"
      }
    },
    {
      "name": "3 - Create Athlete",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"athleteId\": \"athlete-2\",\n  \"userId\": \"athlete-user-2\",\n  \"firstName\": \"Lea\",\n  \"lastName\": \"Schmidt\",\n  \"birthDate\": \"2000-03-20T00:00:00.000Z\",\n  \"gender\": \"female\",\n  \"weightKg\": 62,\n  \"heightCm\": 170,\n  \"trainingLevel\": \"fortgeschritten\",\n  \"sports\": [\"running\", \"cycling\"]\n}"
        },
        "url": "{{baseUrl}}/athletes"
      }
    },
    {
      "name": "4 - Create Session",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"athleteId\": \"{{athleteId}}\",\n  \"sport\": \"running\",\n  \"sensorTypes\": [\"heart-rate\", \"gps\"]\n}"
        },
        "url": "{{baseUrl}}/sessions"
      }
    },
    {
      "name": "5 - Batch Sensor Events",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"events\": [\n    {\n      \"sessionId\": \"{{sessionId}}\",\n      \"timestamp\": \"2026-03-09T10:00:00.000Z\",\n      \"sensorType\": \"heart-rate\",\n      \"heartRate\": 142,\n      \"speed\": 3.8,\n      \"distanceDelta\": 38\n    },\n    {\n      \"sessionId\": \"{{sessionId}}\",\n      \"timestamp\": \"2026-03-09T10:00:10.000Z\",\n      \"sensorType\": \"heart-rate\",\n      \"heartRate\": 146,\n      \"speed\": 3.9,\n      \"distanceDelta\": 39\n    }\n  ]\n}"
        },
        "url": "{{baseUrl}}/sensor-events/batch"
      }
    },
    {
      "name": "6 - Recent Sensor Events",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "url": "{{baseUrl}}/athletes/{{athleteId}}/sensor-events/recent?seconds=3600"
      }
    },
    {
      "name": "7 - Avg Heart Rate",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "url": "{{baseUrl}}/analytics/athletes/{{athleteId}}/average-heart-rate?from=2026-03-09T09:00:00.000Z&to=2026-03-09T11:00:00.000Z"
      }
    },
    {
      "name": "8 - Session Summary",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "url": "{{baseUrl}}/analytics/sessions/{{sessionId}}/summary"
      }
    },
    {
      "name": "9 - Athlete History",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "url": "{{baseUrl}}/analytics/athletes/{{athleteId}}/history"
      }
    },
    {
      "name": "10 - Calculate Load Zones",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "x-user-id", "value": "{{adminUserId}}" },
          { "key": "x-role", "value": "{{adminRole}}" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"maxHeartRate\": 196,\n  \"persist\": true\n}"
        },
        "url": "{{baseUrl}}/analytics/athletes/{{athleteId}}/load-zones/calculate"
      }
    },
    {
      "name": "11 - Athlete Access Guard (Self)",
      "request": {
        "method": "GET",
        "header": [
          { "key": "x-user-id", "value": "{{athleteUserId}}" },
          { "key": "x-role", "value": "{{athleteRole}}" }
        ],
        "url": "{{baseUrl}}/athletes/{{athleteId}}"
      }
    }
  ]
}
